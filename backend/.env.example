# Copy to .env and fill in real values. Every field below is required (no
# defaults) unless noted — the app raises a pydantic ValidationError on boot
# if any are missing. See app/core/config.py for the authoritative list.

# --- Database ---
# Async URL (asyncpg) used at runtime, sync URL (psycopg2) used by Alembic.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fantasy_fusion
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fantasy_fusion

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Optional — defaults to ["http://localhost:3000"] if omitted.
# CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend + email (password reset) ---
# FRONTEND_URL=http://localhost:3000
# PASSWORD_RESET_EXPIRE_MINUTES=30
# Leave SMTP_HOST unset in dev: reset emails are then logged by the backend instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Fantasy Fusion <no-reply@example.com>
# SMTP_STARTTLS=true

# --- FPL (Fantasy Premier League) ---
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
# Verification league: a free FPL classic league (created from your own FPL
# account) that users join to prove they own the team they linked.
# ID is the number in its standings URL (/leagues/<id>/standings/c); CODE is its invite code.
# Leave unset to disable verification (POST /fpl/verify then returns 503).
# FPL_VERIFICATION_LEAGUE_ID=1234567
# FPL_VERIFICATION_LEAGUE_CODE=abc123

# --- M-Pesa (Daraja) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
INITIATOR_NAME=
INITIATOR_PASSWORD=
PARTY_A=
PARTY_B=
PHONE_NUMBER=
BUSINESS_SHORT_CODE=
SECURITY_CREDENTIAL=
COMMAND_ID=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_LIVE_URL=
MPESA_SANDBOX_URL=
B2C_URL=
MPESA_CALLBACK_URL_B2C=
MPESA_CALLBACK_URL_STK=

# --- Stripe (not fully wired — see README "Known gaps") ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_URL=
STRIPE_CONNECT=false

# --- Misc URLs ---
MY_DOMAIN=http://localhost:8000
BACKEND_URL=http://localhost:8000
